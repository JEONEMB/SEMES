// =====================================================================================
// m2_icgn.cpp — M2 구현 + 검증 (설명은 m2_icgn.hpp)
// =====================================================================================
#include "m2_icgn.hpp"
#include "m1_phase_ecc.hpp"

#include <opencv2/imgproc.hpp>
#include <algorithm>
#include <cmath>
#include <complex>
#include <iostream>

namespace yt {
namespace m2 {

namespace {

inline double keys(double t) {   // Keys 3차 보간 가중 (a = −0.5)
    t = std::abs(t);
    if (t < 1.0) return (1.5 * t - 2.5) * t * t + 1.0;
    if (t < 2.0) return ((-0.5 * t + 2.5) * t - 4.0) * t + 2.0;
    return 0.0;
}

inline double sampleLinear(const cv::Mat& I, double x, double y) {
    const int x0 = int(std::floor(x)), y0 = int(std::floor(y));
    const double fx = x - x0, fy = y - y0;
    const float* r0 = I.ptr<float>(y0);
    const float* r1 = I.ptr<float>(y0 + 1);
    return (1 - fy) * ((1 - fx) * r0[x0] + fx * r0[x0 + 1]) + fy * ((1 - fx) * r1[x0] + fx * r1[x0 + 1]);
}

inline double sampleCubic(const cv::Mat& I, double x, double y) {
    const int x0 = int(std::floor(x)), y0 = int(std::floor(y));
    const double fx = x - x0, fy = y - y0;
    double wx[4], wy[4];
    for (int i = 0; i < 4; ++i) { wx[i] = keys(fx - (i - 1)); wy[i] = keys(fy - (i - 1)); }
    double s = 0;
    for (int j = 0; j < 4; ++j) {
        const float* r = I.ptr<float>(y0 - 1 + j);
        const double row = wx[0] * r[x0 - 1] + wx[1] * r[x0] + wx[2] * r[x0 + 1] + wx[3] * r[x0 + 2];
        s += wy[j] * row;
    }
    return s;
}

cv::Matx33d toM(const Affine& p) { return cv::Matx33d(1 + p.ux, p.uy, p.u, p.vx, 1 + p.vy, p.v, 0, 0, 1); }
Affine fromM(const cv::Matx33d& M) {
    Affine p;
    p.ux = M(0, 0) - 1; p.uy = M(0, 1); p.u = M(0, 2);
    p.vx = M(1, 0); p.vy = M(1, 1) - 1; p.v = M(1, 2);
    return p;
}

Result icgnSingle(const cv::Mat& ref, const cv::Mat& cur, int cx, int cy, int hw, const Affine& init, bool cubic, int maxIter) {
    Result res;
    const int side = 2 * hw + 1, n = side * side, margin = 3;
    if (cx - hw - 2 < 0 || cy - hw - 2 < 0 || cx + hw + 2 >= ref.cols || cy + hw + 2 >= ref.rows) return res;
    // 기준 부분 영역 : 값, 기울기, 가파른 하강 영상, Hessian (역합성이라 한 번만)
    std::vector<double> f(n), J(6 * size_t(n));
    double fm = 0;
    int k = 0;
    for (int j = -hw; j <= hw; ++j)
        for (int i = -hw; i <= hw; ++i, ++k) {
            const float* r = ref.ptr<float>(cy + j);
            f[k] = r[cx + i];
            fm += f[k];
        }
    fm /= n;
    double df = 0;
    k = 0;
    cv::Matx<double, 6, 6> H = cv::Matx<double, 6, 6>::zeros();
    for (int j = -hw; j <= hw; ++j)
        for (int i = -hw; i <= hw; ++i, ++k) {
            f[k] -= fm;
            df += f[k] * f[k];
            const double gx = 0.5 * (ref.at<float>(cy + j, cx + i + 1) - ref.at<float>(cy + j, cx + i - 1));
            const double gy = 0.5 * (ref.at<float>(cy + j + 1, cx + i) - ref.at<float>(cy + j - 1, cx + i));
            double* Jk = &J[6 * size_t(k)];
            Jk[0] = gx; Jk[1] = gx * i; Jk[2] = gx * j; Jk[3] = gy; Jk[4] = gy * i; Jk[5] = gy * j;
            for (int a = 0; a < 6; ++a)
                for (int b = 0; b < 6; ++b) H(a, b) += Jk[a] * Jk[b];
        }
    df = std::sqrt(df);
    const cv::Matx<double, 6, 6> Hi = H.inv(cv::DECOMP_CHOLESKY);

    cv::Matx33d M = toM(init);
    std::vector<double> g(n);
    for (int it = 0; it < maxIter; ++it) {
        const Affine p = fromM(M);
        // 현재 영상에서 변형 위치의 값
        double gm = 0;
        k = 0;
        bool inb = true;
        for (int j = -hw; j <= hw && inb; ++j)
            for (int i = -hw; i <= hw; ++i, ++k) {
                const double x = cx + p.u + (1 + p.ux) * i + p.uy * j;
                const double y = cy + p.v + p.vx * i + (1 + p.vy) * j;
                if (x < margin || y < margin || x > cur.cols - margin - 1 || y > cur.rows - margin - 1) { inb = false; break; }
                g[k] = cubic ? sampleCubic(cur, x, y) : sampleLinear(cur, x, y);
                gm += g[k];
            }
        if (!inb) return res;
        gm /= n;
        double dg = 0;
        for (int q = 0; q < n; ++q) { g[q] -= gm; dg += g[q] * g[q]; }
        dg = std::sqrt(dg);
        // b = Σ Jᵀ (f̄ − Δf/Δg · ḡ),  Δp = −H⁻¹ b
        cv::Vec<double, 6> b = cv::Vec<double, 6>::all(0);
        double zn = 0;
        const double r = df / dg;
        for (int q = 0; q < n; ++q) {
            const double e = f[q] - r * g[q];
            const double* Jq = &J[6 * size_t(q)];
            for (int a = 0; a < 6; ++a) b[a] += Jq[a] * e;
            zn += f[q] * g[q];
        }
        const cv::Vec<double, 6> dp = -(Hi * b);
        Affine d;
        d.u = dp[0]; d.ux = dp[1]; d.uy = dp[2]; d.v = dp[3]; d.vx = dp[4]; d.vy = dp[5];
        M = M * toM(d).inv();   // 역합성 갱신 W(p) ← W(p) ∘ W(Δp)⁻¹
        res.zncc = zn / (df * dg);
        res.iters = it + 1;
        const double step = std::sqrt(d.u * d.u + d.v * d.v + (d.ux * d.ux + d.uy * d.uy + d.vx * d.vx + d.vy * d.vy) * hw * hw);
        if (step < 1e-6) break;
    }
    res.p = fromM(M);
    res.ok = std::isfinite(res.p.u) && res.zncc > 0.5;
    return res;
}

} // namespace

Result icgn(const cv::Mat& ref, const cv::Mat& cur, int cx, int cy, int hw, const Affine& init, Interp interp, int maxIter) {
    if (interp == Interp::Linear) return icgnSingle(ref, cur, cx, cy, hw, init, false, maxIter);
    if (interp == Interp::Cubic) return icgnSingle(ref, cur, cx, cy, hw, init, true, maxIter);
    const Result a = icgnSingle(ref, cur, cx, cy, hw, init, false, maxIter);
    const Result b = icgnSingle(ref, cur, cx, cy, hw, init, true, maxIter);
    Result r;
    r.ok = a.ok && b.ok;
    r.zncc = std::min(a.zncc, b.zncc);
    r.iters = std::max(a.iters, b.iters);
    r.p.u = 0.5 * (a.p.u + b.p.u); r.p.ux = 0.5 * (a.p.ux + b.p.ux); r.p.uy = 0.5 * (a.p.uy + b.p.uy);
    r.p.v = 0.5 * (a.p.v + b.p.v); r.p.vx = 0.5 * (a.p.vx + b.p.vx); r.p.vy = 0.5 * (a.p.vy + b.p.vy);
    return r;
}

double gradientOneStep(const cv::Mat& ref, const cv::Mat& cur, int cx, int cy, int hw, int gi) {
    // cur(x) = ref(x − δ) 일 때 c(ξ) = cur(ξ + gi) ≈ f(ξ) + f'(ξ)·(gi − δ)  →  δ = gi − Σ f'·e / Σ f'²
    double fm = 0, cm = 0;
    const int side = 2 * hw, n = side * side;
    for (int j = -hw; j < hw; ++j)
        for (int i = -hw; i < hw; ++i) { fm += ref.at<float>(cy + j, cx + i); cm += cur.at<float>(cy + j, cx + i + gi); }
    fm /= n; cm /= n;
    double num = 0, den = 0;
    for (int j = -hw; j < hw; ++j)
        for (int i = -hw; i < hw; ++i) {
            const double gx = (ref.at<float>(cy + j, cx + i + 1) - ref.at<float>(cy + j, cx + i - 1)) / 2.0;
            const double e = (cur.at<float>(cy + j, cx + i + gi) - cm) - (ref.at<float>(cy + j, cx + i) - fm);
            num += gx * e; den += gx * gx;
        }
    return gi - num / den;
}

double dpg(const cv::Mat& ref, const cv::Mat& cur, int cx, int cy, int hw, int giFloor) {
    const double s0 = gradientOneStep(ref, cur, cx, cy, hw, giFloor);
    const double s1 = gradientOneStep(ref, cur, cx, cy, hw, giFloor + 1);
    const double w = std::min(1.0, std::max(0.0, s0 - giFloor));   // 가까운 정수 중심에 큰 가중
    return (1 - w) * s0 + w * s1;
}

// =====================================================================================
// 검증
// =====================================================================================
namespace {

// 행마다 띠 제한 보간(DFT 계수로 임의 위치 값 계산) — 정확한 늘어남 + 이동 영상 생성
cv::Mat stretchX(const cv::Mat& src32, double eps, double shift) {
    const int H = src32.rows, N = src32.cols;
    const double c = N / 2.0;
    cv::Mat out(H, N, CV_32F);
    std::vector<std::complex<double>> C(N), e1(N);
    for (int y = 0; y < H; ++y) {
        cv::Mat row64, F;
        src32.row(y).convertTo(row64, CV_64F);
        cv::dft(row64, F, cv::DFT_COMPLEX_OUTPUT);
        for (int k = 0; k < N; ++k) C[k] = std::complex<double>(F.at<cv::Vec2d>(0, k)[0], F.at<cv::Vec2d>(0, k)[1]);
        for (int x = 0; x < N; ++x) {
            const double X = c + (x - c - shift) / (1.0 + eps);   // 출력 x 가 가져올 원본 위치
            std::complex<double> s(0, 0);
            for (int k = 0; k < N; ++k) {
                const int kk = k <= N / 2 ? k : k - N;
                double wgt = 1.0;
                if (N % 2 == 0 && k == N / 2) wgt = 0.5;   // 나이퀴스트 성분 반반
                s += wgt * C[k] * std::exp(std::complex<double>(0, 2.0 * CV_PI * kk * X / N));
                if (N % 2 == 0 && k == N / 2) s += wgt * C[k] * std::exp(std::complex<double>(0, -2.0 * CV_PI * kk * X / N));
            }
            out.at<float>(y, x) = float(s.real() / N);
        }
    }
    return out;
}

} // namespace

bool verify(const std::vector<Sample>& ds, const std::string& outDir, const std::string& m1Csv) {
    Report rep(outDir, "M2 IC-GN 아핀 정합 + 서브픽셀 치우침 감소 — 검증 결과");
    const Sample* refS = findStem(ds, "center");
    if (!refS) { rep.check("기준 영상", false, "center 없음"); return false; }
    const cv::Mat ref = loadGray32(refS->path);
    const Region& QL = regions()[0];
    const int hw = QL.hw - 6, P = 64;
    const cv::Rect B(QL.cx - hw - P, QL.cy - hw - P, 2 * (hw + P), 2 * (hw + P));
    const cv::Mat big = ref(B).clone();
    const int c0 = hw + P;

    // ---------------- V2-1 부분 화소 이동
    rep.h("V2-1 합성 부분 화소 이동 — 보간 방식별 치우침");
    rep.line("QR_L 영역을 푸리에 위상 회전으로 정확히 (dx, 0.25) px 이동. 늘어남은 0 이 정답.");
    {
        Csv csv(outDir + "/m2_synthetic_subpixel.csv");
        csv << "dx_true" << "u_linear" << "u_cubic" << "u_dual" << "ux_linear" << "ux_cubic" << "ux_dual" << "v_dual";
        csv.endl();
        std::vector<double> eL, eC, eD, xL, xC, xD;
        for (int i = 0; i <= 20; ++i) {
            const double dx = 0.05 * i;
            const cv::Mat sh = fourierShift(big, dx, 0.25);
            Affine init; init.u = std::round(dx); init.v = 0;
            const Result L = icgn(big, sh, c0, c0, hw, init, Interp::Linear);
            const Result C = icgn(big, sh, c0, c0, hw, init, Interp::Cubic);
            const Result D = icgn(big, sh, c0, c0, hw, init, Interp::Dual);
            csv << dx << L.p.u << C.p.u << D.p.u << L.p.ux << C.p.ux << D.p.ux << D.p.v;
            csv.endl();
            eL.push_back(L.p.u - dx); eC.push_back(C.p.u - dx); eD.push_back(D.p.u - dx);
            xL.push_back(L.p.ux); xC.push_back(C.p.ux); xD.push_back(D.p.ux);
        }
        const Stat a = stat(eL), b = stat(eC), c = stat(eD), xa = stat(xL), xb = stat(xC), xc = stat(xD);
        rep.table({"보간", "이동 치우침 RMS (px)", "최대 (px)", "늘어남 ux 최대 (정답 0)"},
                  {{"선형", fmt("%.4f", a.rms), fmt("%.4f", a.maxAbs), fmt("%.2e", xa.maxAbs)},
                   {"3차 (Keys)", fmt("%.4f", b.rms), fmt("%.4f", b.maxAbs), fmt("%.2e", xb.maxAbs)},
                   {"DUAL (두 결과 평균)", fmt("%.4f", c.rms), fmt("%.4f", c.maxAbs), fmt("%.2e", xc.maxAbs)}});
        rep.check("DUAL 치우침 감소", c.rms <= 0.006 && c.rms < 0.5 * std::min(a.rms, b.rms),
                  fmt("DUAL %.4f px  (선형 %.4f, 3차 %.4f — 절반 이하, 0.006 이하)", c.rms, a.rms, b.rms));
        rep.check("이동만 있을 때 늘어남 0 유지", xc.maxAbs <= 3e-5, fmt("DUAL ux 최대 %.2e (≤ 3e-5)", xc.maxAbs));
    }

    // ---------------- V2-2 늘어남 주입
    rep.h("V2-2 합성 늘어남 주입 — ux 를 정확히 읽는가");
    rep.line("행마다 띠 제한(DFT) 보간으로 가로 방향만 정확히 (1+ε) 배 늘리고 0.3 px 이동한 영상을 만들어 측정. Θ 0.01° 의 좌·우 차 신호는 3.4e-5 수준.");
    {
        Csv csv(outDir + "/m2_synthetic_stretch.csv");
        csv << "eps_true" << "ux_linear" << "ux_cubic" << "ux_dual" << "u_dual";
        csv.endl();
        std::vector<std::vector<std::string>> rows;
        bool ok = true;
        for (const double eps : {2e-5, 5e-5, 2e-4, 5e-4, 1e-3, -5e-4}) {
            const cv::Mat st = stretchX(big, eps, 0.3);
            Affine init; init.u = 0;
            const Result L = icgn(big, st, c0, c0, hw, init, Interp::Linear);
            const Result C = icgn(big, st, c0, c0, hw, init, Interp::Cubic);
            const Result D = icgn(big, st, c0, c0, hw, init, Interp::Dual);
            csv << eps << L.p.ux << C.p.ux << D.p.ux << D.p.u;
            csv.endl();
            const double err = D.p.ux - eps;
            const bool o = std::abs(err) <= 0.05 * std::abs(eps) + 3e-6;
            ok = ok && o;
            rows.push_back({fmt("%+.1e", eps), fmt("%+.3e", L.p.ux), fmt("%+.3e", C.p.ux), fmt("%+.3e", D.p.ux), fmt("%+.1e", err), o ? "통과" : "미통과"});
        }
        rep.table({"넣은 ε", "선형 ux", "3차 ux", "DUAL ux", "DUAL 오차", "판정"}, rows);
        rep.check("늘어남 측정 정확도", ok, "모든 ε 에서 |오차| ≤ 5 % · |ε| + 3e-6");
    }

    // ---------------- V2-3 DPG
    rep.h("V2-3 DPG (Liu 2021) — 두 정수 중심 결합");
    {
        Csv csv(outDir + "/m2_synthetic_dpg.csv");
        csv << "dx_true" << "onestep_c0" << "onestep_c1" << "dpg";
        csv.endl();
        std::vector<double> e0, e1, ed;
        for (int i = 0; i <= 20; ++i) {
            const double dx = 0.05 * i;
            const cv::Mat sh = fourierShift(big, dx, 0.0);
            const double a = gradientOneStep(big, sh, c0, c0, hw, 0), b = gradientOneStep(big, sh, c0, c0, hw, 1), d = dpg(big, sh, c0, c0, hw, 0);
            csv << dx << a << b << d;
            csv.endl();
            e0.push_back(a - dx); e1.push_back(b - dx); ed.push_back(d - dx);
        }
        const Stat a = stat(e0), b = stat(e1), d = stat(ed);
        rep.table({"방법", "치우침 RMS (px)", "최대 (px)"},
                  {{"1단계 기울기법 (아래 정수 중심)", fmt("%.4f", a.rms), fmt("%.4f", a.maxAbs)},
                   {"1단계 기울기법 (위 정수 중심)", fmt("%.4f", b.rms), fmt("%.4f", b.maxAbs)},
                   {"DPG 결합", fmt("%.4f", d.rms), fmt("%.4f", d.maxAbs)}});
        rep.check("DPG 원리 재현", d.rms <= 0.5 * std::min(a.rms, b.rms), fmt("DPG %.4f px ≤ 단일 중심의 절반 (%.4f)", d.rms, 0.5 * std::min(a.rms, b.rms)));
        rep.line("IC-GN 반복법은 이미 1단계법보다 정확하므로, 실제 측정에는 DPG 대신 DUAL(선형·3차 평균)을 사용한다.");
    }

    // ---------------- V2-4 실제 사진
    rep.h("V2-4 실제 사진 — QR 별 아핀 정합 (DUAL)");
    const CsvTable m1 = readCsv(m1Csv);
    if (m1.empty()) { rep.check("M1 결과", false, "m1_shifts.csv 없음 — M1 먼저 실행"); return false; }
    std::vector<double> tT, dT, tY, dY, times;
    double minZ = 1;
    int fails = 0;
    {
        Csv csv(outDir + "/m2_affine.csv");
        csv << "stem" << "set" << "shot" << "y_mm" << "t_deg";
        for (int q = 0; q < 3; ++q) {
            const std::string nm = regions()[q].name;
            for (const char* c : {"_u", "_v", "_ux", "_uy", "_vx", "_vy", "_ux_lin", "_ux_cub", "_zncc"}) csv << nm + c;
        }
        csv << "dEx" << "dEy" << "ms";
        csv.endl();
        cv::Mat ref2;
        int done = 0;
        for (const auto& s : ds) {
            if (s.stem == "center" || s.stem == "center1") continue;
            const cv::Mat& R = s.set_id == 1 ? ref : (ref2.empty() ? (ref2 = loadGray32(findStem(ds, "center1")->path)) : ref2);
            const cv::Mat cur = loadGray32(s.path);
            Timer t;
            csv << s.stem << s.set_id << s.shot << s.y_mm << s.t_deg;
            double ux[3] = {0, 0, 0}, vy[3] = {0, 0, 0};
            bool all = true;
            for (int q = 0; q < 3; ++q) {
                const Region& r = regions()[q];
                Affine init;
                init.u = num(m1, s.stem, r.name + "_dx");
                init.v = num(m1, s.stem, r.name + "_dy");
                if (!std::isfinite(init.u)) { init.u = num(m1, s.stem, "coarse_dx"); init.v = num(m1, s.stem, "coarse_dy"); }
                const Result L = icgn(R, cur, r.cx, r.cy, r.hw - 6, init, Interp::Linear);
                const Result C = icgn(R, cur, r.cx, r.cy, r.hw - 6, init, Interp::Cubic);
                Affine D;
                D.u = 0.5 * (L.p.u + C.p.u); D.v = 0.5 * (L.p.v + C.p.v); D.ux = 0.5 * (L.p.ux + C.p.ux);
                D.uy = 0.5 * (L.p.uy + C.p.uy); D.vx = 0.5 * (L.p.vx + C.p.vx); D.vy = 0.5 * (L.p.vy + C.p.vy);
                const bool ok = L.ok && C.ok;
                all = all && ok;
                minZ = std::min(minZ, std::min(L.zncc, C.zncc));
                csv << D.u << D.v << D.ux << D.uy << D.vx << D.vy << L.p.ux << C.p.ux << std::min(L.zncc, C.zncc);
                ux[q] = D.ux; vy[q] = D.vy;
            }
            const double ms = t.ms();
            csv << ux[2] - ux[0] << vy[2] - vy[0] << ms;
            csv.endl();
            times.push_back(ms);
            if (!all) ++fails;
            if (s.set_id == 1 && all) {
                if (s.y_mm == 0) { tT.push_back(s.t_deg); dT.push_back(ux[2] - ux[0]); }
                if (s.t_deg == 0) { tY.push_back(s.y_mm); dY.push_back(ux[2] - ux[0]); }
            }
            if (++done % 50 == 0) std::cout << "    " << done << " 장\n";
        }
    }
    std::vector<std::vector<double>> A;
    for (double t : tT) A.push_back({1.0, t, t * t});
    const auto bT = lstsq(A, dT);
    std::vector<double> rT;
    for (size_t i = 0; i < tT.size(); ++i) rT.push_back(dT[i] - (bT[0] + bT[1] * tT[i] + bT[2] * tT[i] * tT[i]));
    A.clear();
    for (double y : tY) A.push_back({1.0, y});
    const auto bY = lstsq(A, dY);
    const Stat tm = stat(times), sr = stat(rT);
    rep.table({"항목", "값"},
              {{"측정 사진 수 / 실패", fmt("%d / %d", int(times.size()), fails)},
               {"ZNCC 최소", fmt("%.4f", minZ)},
               {"ε_R − ε_L 의 Θ 감도 (1차 Θ 스윕)", fmt("%.3e /°  (Θ² %.2e), 잔차 σ %.2e", bT[1], bT[2], sr.sd)},
               {"ε_R − ε_L 의 Y 감도 (1차 Y 스윕)", fmt("%.2e /mm", bY[1])},
               {"처리 시간 / 장 (QR 3개 × 보간 2종)", fmt("평균 %.0f ms", tm.mean)}});
    rep.check("수렴", fails == 0 && minZ >= 0.98, fmt("실패 %d, ZNCC 최소 %.4f (≥ 0.98)", fails, minZ));
    rep.check("원근 단서 감도 (운동 모델 이론 3.3e-3 ~ 3.5e-3 /°, ±15 %)", bT[1] >= 2.8e-3 && bT[1] <= 4.0e-3, fmt("%.3e /°", bT[1]));
    rep.check("Y 에는 둔감", std::abs(bY[1]) <= 3e-4, fmt("%.2e /mm (≤ 3e-4, Θ 환산 %.3f °/mm)", bY[1], bY[1] / bT[1]));
    return rep.allOk();
}

} // namespace m2
} // namespace yt
