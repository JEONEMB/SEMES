// =====================================================================================
// roi_opt.hpp — 최적 ROI 학습 (Hypothesis 5)
//
//  목적 : 플레이트 QR 외에 어떤 배경 영역(ROI)을 함께 써야 Y·Θ 오차가 가장 작은가를 데이터로 정함
//  후보 : 탐색 구역(벽 / 하단 문 / 중간 돌출부 위·아래)마다 질감 점수(Shi–Tomasi 최소 고유값) 상위 패치
//         + 기존 벽 ROI 6개. 구역 좌표는 config/roi_search.yml (없으면 기본값으로 생성)
//  측정 : M1 과 같은 절차 (플레이트 거친 이동 → 2배 창 위상 상관 → ECC) 로 후보마다 가로 이동 dx
//  특징 : s = QR 3개 평균 dx,  d = s − (선택 ROI 들의 평균 dx)  (플레이트와 배경의 상대 이동 = 시차)
//         → 기존 트랙 B (아래 벽 4곳 평균) 는 '선택 = W1~W4' 인 한 경우
//  선택 : 1차 '첫 번째 측정' (center, Y 0.1 mm 배수, Θ 스윕) 만으로
//         블록 교차검증 오차 J = √mean((eY/90µm)² + (eΘ/0.01°)²) 를 줄이는 ROI 를 평균 묶음에 하나씩 추가 (빔 탐색, 폭 5)
//  시험 : 2차 세트는 선택·학습에 쓰지 않고 마지막에 한 번만 평가
// =====================================================================================
#ifndef YT_ROI_OPT_HPP
#define YT_ROI_OPT_HPP

#include "../yt/yt_common.hpp"

namespace yt {
namespace roi {

struct Zone { std::string name; cv::Rect box; int topK; };
struct SearchConfig {
    std::vector<Zone> zones;
    std::vector<cv::Rect> exclude;   // 후보에서 뺄 곳 (QR 띠 — QR 은 기본 특징 s 로 따로 씀)
    int hw = 60;                     // 후보 반폭 (px)
    int step = 40;                   // 격자 간격
    int nmsDist = 110;               // 같은 구역 후보끼리 최소 거리
    int margin = 300;                // 화면 가장자리 여유 (Θ 2° ≈ 160 px 이동 + 2배 창)
    int maxSelect = 10;               // 최대 선택 수
    double minGain = 0.02;           // 추가 시 J 가 이만큼(비율) 이상 줄어야 채택
    int beam = 5;                    // 빔 탐색 폭 (크기마다 남기는 상위 묶음 수)
    double tolY_um = 90.0, tolT_deg = 0.01;
};
SearchConfig loadOrCreateConfig(const std::string& path);

struct Cand { std::string name, zone; int cx, cy, hw; double score; };
std::vector<Cand> makeCandidates(const cv::Mat& ref32, const SearchConfig& cfg);

// 1차 첫 번째 측정 여부 (촬영 기록 확인 : Y 0.05 홀수 값만 약 48분 뒤 두 번째 측정)
bool firstSession(const Sample& s);

bool verify(const std::vector<Sample>& ds, const std::string& outDir, const std::string& cfgPath);

} // namespace roi
} // namespace yt

#endif
