    "correlation_min": 0.9,
    "contrast_min": 5.0,
    "positive_gain_range": [
      0.25,
      4.0
    ],
    "max_abs_shift_for_valid": 11.5
  },
  "features": "24 vertical shifts per upper/lower line (left12,right12); measured coordinates and all per-block validity diagnostics retained",
  "failure_policy": "X value is NaN for an invalid block; success_upper/lower requires all24 blocks valid. Raw measured shifts and failure reasons remain saved. No label-dependent omission or point replacement.",
  "outside_mask_policy": "Every current image sample read by extractor is inside the union of fixed49x64 boxes. Gaussian smoothing is applied only to extracted1D profiles. No full-image blur/NCC/ECC.",
  "prohibited_inputs": [
    "bolts",
