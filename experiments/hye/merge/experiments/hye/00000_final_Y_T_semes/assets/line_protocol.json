  "method": "Average64 image columns to one normal intensity profile per fixed block; sigma1 smoothing only inside49-row read box; match21-sample reference profile by continuous vertical shift and affine intensity normalization; no horizontal tracking, texture descriptor or forbidden object input.",
  "parameters": {
    "block_width": 64,
    "blocks_per_segment": 12,
    "profile_smoothing_sigma": 1.0,
    "reference_half_width": 10,
    "search_half_width": 12,
