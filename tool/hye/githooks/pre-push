#!/bin/sh
# 보호 브랜치로의 직접 push 차단. 통합은 MR 로만 한다.
# 우회: SEMES_ALLOW_PROTECTED=1 git push ...

[ -n "$SEMES_ALLOW_PROTECTED" ] && exit 0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/chore/hye/merge|refs/heads/dev|refs/heads/main|refs/heads/master)
      cat >&2 <<MSG

push 거부: '$remote_ref' 로 직접 push 하지 않는다. 통합은 MR 로만 한다.

  작업 브랜치를 push 하고 MR 대상 브랜치를 chore/hye/merge 로 연다.
  머지는 사용자가 GitLab 에서 직접 승인한다.

규칙 전문: AGENTS.md 의 'Git 작업 흐름 (hye, 강제)'

MSG
      exit 1
      ;;
  esac
done
exit 0
